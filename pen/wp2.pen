            18
          ],
          "children": [
            {
              "type": "text",
              "id": "v8VEB",
              "fill": "$ink",
              "content": "01  THE EMPTY WALLET MYTH",
              "fontFamily": "$font-display",
              "fontSize": 24,
              "fontWeight": "normal",
              "letterSpacing": -0.6
            },
            {
              "type": "text",
              "id": "Y9XTo",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Most crypto product onboarding still assumes the user arrives with a funded wallet, a preferred chain and a mental model of gas. That is false for the majority of first-time sessions we instrumented.",
              "lineHeight": 1.6,
              "fontFamily": "$font-mono",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "U3TDhm",
              "fill": "$ink-60",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "We redesigned the first surface as a state machine: no wallet, wrong chain, empty balance, funded. Each state has its own CTA, helper copy and exit path.",
              "lineHeight": 1.6,
              "fontFamily": "$font-mono",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "SqDwV",
              "name": "Pull",
              "width": "fill_container",
              "fill": "$flame",
              "stroke": "$ink",
              "strokeWidth": 2,
              "strokeAlignment": "inner",
              "layout": "vertical",
              "gap": 8,
              "padding": 18,
              "children": [
                {
                  "type": "text",
                  "id": "pklSl",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "“If the first screen cannot name the user’s current state, the product is lying.”",
                  "lineHeight": 1.2,
                  "fontFamily": "$font-display",
                  "fontSize": 20,
                  "fontWeight": "normal",
                  "letterSpacing": -0.4
                },
                {
                  "type": "text",
                  "id": "iRWlp",
                  "fill": "$ink",
                  "content": "— MIRA CHEN",
                  "fontFamily": "$font-mono",
                  "fontSize": 11,
                  "fontWeight": "700",
                  "letterSpacing": 1
                }
              ]
            },
            {
              "type": "text",
              "id": "V9q7ii",
              "fill": "$ink",
              "content": "02  NINE-MINUTE TUNNEL",
              "fontFamily": "$font-display",
              "fontSize": 24,
              "fontWeight": "normal",
              "letterSpacing": -0.6
            },
            {
              "type": "text",
              "id": "f3yWX3",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Median time from land to first successful message dropped from 27 minutes to 9. The biggest win was not fewer steps — it was fewer ambiguous ones.",
              "lineHeight": 1.6,
              "fontFamily": "$font-mono",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
