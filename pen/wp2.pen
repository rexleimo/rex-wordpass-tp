                56,
                48
              ],
              "children": [
                {
                  "type": "text",
                  "id": "jLrRn",
                  "name": "h2",
                  "fill": "$ink",
                  "content": "01  THE EMPTY WALLET MYTH",
                  "fontFamily": "$font-display",
                  "fontSize": 32,
                  "fontWeight": "normal",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "J1Kwf",
                  "name": "p1",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Most crypto product onboarding still assumes the user arrives with a funded wallet, a preferred chain and a mental model of gas. That is false for the majority of first-time sessions we instrumented.",
                  "lineHeight": 1.65,
                  "fontFamily": "$font-mono",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vFC84",
                  "name": "p2",
                  "fill": "$ink-60",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "We redesigned the first surface as a state machine: no wallet, wrong chain, empty balance, funded. Each state has its own CTA, helper copy and exit path. No more dead ends that dump users into a blank dashboard.",
                  "lineHeight": 1.65,
                  "fontFamily": "$font-mono",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "M0HMp",
                  "name": "Pull",
                  "width": "fill_container",
                  "fill": "$flame",
                  "stroke": "$ink",
                  "strokeWidth": 2,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": 10,
                  "padding": [
                    24,
                    28
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "Z0aabZ",
                      "name": "q",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "“If the first screen cannot name the user’s current state, the product is lying.”",
                      "lineHeight": 1.15,
                      "fontFamily": "$font-display",
                      "fontSize": 28,
                      "fontWeight": "normal",
                      "letterSpacing": -0.8
                    },
                    {
                      "type": "text",
                      "id": "PBZQK",
                      "name": "a",
                      "fill": "$ink",
                      "content": "— MIRA CHEN, PRODUCT DESIGN",
                      "fontFamily": "$font-mono",
                      "fontSize": 11,
                      "fontWeight": "700",
                      "letterSpacing": 1.2
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "h5zp8o",
                  "name": "h2b",
                  "fill": "$ink",
                  "content": "02  NINE-MINUTE TUNNEL",
                  "fontFamily": "$font-display",
                  "fontSize": 32,
                  "fontWeight": "normal",
                  "letterSpacing": -1
                },
                {
                  "type": "text",
                  "id": "vef0k",
                  "name": "p3",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Median time from land to first successful message dropped from 27 minutes to 9. The biggest win was not fewer steps — it was fewer ambiguous ones. We cut three “continue” buttons that did nothing visible.",
                  "lineHeight": 1.65,
                  "fontFamily": "$font-mono",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
