              "y": 49,
              "name": "Image Motion Section Title",
              "fill": "#141B34",
              "textGrowth": "fixed-width",
              "width": 780,
              "content": "Photographs are the motion stage, not decorative filler.",
              "fontFamily": "Funnel Sans",
              "fontSize": 28,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "nW5xJ",
              "x": 24,
              "y": 87,
              "name": "Image Motion Section Description",
              "fill": "#66708A",
              "textGrowth": "fixed-width",
              "width": 900,
              "content": "Use the real product, workshop and project images as the visual rhythm: reveal them on scroll, let the image breathe on hover, and keep the blue and gold as interface accents.",
