        {
          "type": "text",
          "id": "ZfdrY",
          "x": 718,
          "y": 531,
          "name": "Motion Selector Contract Text",
          "fill": "#66708A",
          "textGrowth": "fixed-width",
          "width": 636,
          "content": "[data-home-hero]  [data-hero-copy]  [data-hero-action]  [data-print-head]  [data-connector]  [data-scan]  [data-route-section]",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 9,
          "fontWeight": "500",
          "letterSpacing": 0.05
        },
        {
          "type": "text",
          "id": "HRZEr",
          "x": 704,
          "y": 578,
          "name": "GSAP Intro Code Label",
          "fill": "#222C97",
          "textGrowth": "fixed-width",
          "width": 300,
          "content": "A  /  PAGE LOAD  /  GSAP TIMELINE",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "600",
          "letterSpacing": 0.5
        },
        {
          "type": "frame",
          "id": "P9hMp",
          "x": 704,
          "y": 598,
          "name": "GSAP Intro Code Block",
          "width": 664,
          "height": 116,
          "fill": "#141B34",
          "cornerRadius": 8,
          "layout": "none"
        },
        {
          "type": "text",
          "id": "ZA6zN",
          "x": 720,
          "y": 612,
          "name": "GSAP Intro Code",
          "fill": "#DAE0FF",
          "textGrowth": "fixed-width",
          "width": 634,
          "content": "const intro = gsap.timeline({ defaults: { ease: \"power3.out\" } });\nintro.from(\"[data-hero-copy]\", { y: 28, autoAlpha: 0, duration: .65 })\n  .from(\"[data-hero-action]\", { y: 16, autoAlpha: 0, stagger: .08 }, \"-=.25\")\n  .from(\"[data-print-head]\", { y: -60, autoAlpha: 0, duration: .55 }, \"-=.30\");",
          "lineHeight": 1.45,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 9,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "TxLfl",
          "x": 704,
          "y": 738,
          "name": "GSAP Scroll Code Label",
          "fill": "#222C97",
          "textGrowth": "fixed-width",
          "width": 310,
          "content": "B  /  DESKTOP SCROLL  /  SCROLLTRIGGER",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "600",
          "letterSpacing": 0.5
        },
        {
          "type": "frame",
          "id": "xV251",
          "x": 704,
          "y": 758,
          "name": "GSAP Scroll Code Block",
          "width": 664,
          "height": 174,
          "fill": "#141B34",
          "cornerRadius": 8,
          "layout": "none"
        },
        {
          "type": "text",
          "id": "HYIg7",
          "x": 720,
          "y": 772,
          "name": "GSAP Scroll Code",
          "fill": "#DAE0FF",
          "textGrowth": "fixed-width",
          "width": 634,
          "content": "ScrollTrigger.create({ trigger: \".home-hero\", start: \"top top\",\n  end: \"+=900\", pin: true, scrub: .6,\n  animation: gsap.timeline()\n    .to(\"[data-connector]\", { rotateY: 32, x: -36 })\n    .to(\"[data-scan]\", { scaleX: 1, autoAlpha: 1 }, 0)\n    .to(\"[data-route-section]\", { y: 0, autoAlpha: 1 }, .45)\n});",
          "lineHeight": 1.42,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 9,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "DvYTp",
          "x": 704,
          "y": 956,
          "name": "CSS Motion Code Label",
          "fill": "#222C97",
          "textGrowth": "fixed-width",
          "width": 360,
          "content": "C  /  IDLE EFFECTS + ACCESSIBILITY  /  CSS",
          "fontFamily": "IBM Plex Mono",
          "fontSize": 10,
          "fontWeight": "600",
          "letterSpacing": 0.5
        },
        {
          "type": "frame",
          "id": "e2yhG",
          "x": 704,
          "y": 976,
          "name": "CSS Motion Code Block",
          "width": 664,
          "height": 132,
          "fill": "#141B34",
          "cornerRadius": 8,
          "layout": "none"
        },
        {
          "type": "text",
          "id": "eNUSO",
          "x": 720,
          "y": 990,
          "name": "CSS Motion Code",
          "fill": "#DAE0FF",
          "textGrowth": "fixed-width",
          "width": 634,
          "content": "[data-hero-copy], [data-hero-action] { will-change: transform, opacity; }\n.hero-stage__scan { animation: scan-pass 2.8s ease-in-out infinite; }\n.hero-stage__connector { animation: idle-rotate 18s linear infinite; transform-style: preserve-3d; }\n@keyframes scan-pass {\n  0%,100% { transform: translateX(-110%); opacity:0; }\n  50% { transform: translateX(110%); opacity:1; }\n}\n@keyframes idle-rotate { to { transform: rotateY(360deg); } }\n@media (prefers-reduced-motion: reduce) { .hero-stage__scan, .hero-stage__connector { animation:none; } }",
          "lineHeight": 1.3,
          "fontFamily": "IBM Plex Mono",
          "fontSize": 8.5,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "q8CJf",
          "x": 704,
          "y": 1122,
          "name": "Motion Delivery Rules",
          "fill": "#66708A",
          "textGrowth": "fixed-width",
          "width": 664,
          "content": "Desktop: use gsap.matchMedia() to pin the hero. Mobile: no pin and no drag rotation; retain only a short scan loop. Animate transform + opacity only — never top, left, width or height.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 10,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "CAHek",
