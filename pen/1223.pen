                  "fill": "#DAE0FF",
                  "textGrowth": "fixed-width",
                  "width": 1216,
                  "content": "[data-media-reveal] { overflow:hidden; }  [data-media-reveal] img { transition: transform .7s cubic-bezier(.2,.8,.2,1); }  @media (hover:hover) { [data-media-card]:hover img { transform:scale(1.045); } }  gsap.from('[data-media-reveal]', { y:32, autoAlpha:0, scale:1.07, stagger:.12, duration:.8, ease:'power3.out', scrollTrigger:{ start:'top 82%' } });  @media (prefers-reduced-motion:reduce) { * { animation:none!important; transition:none!important; } }",
                  "lineHeight": 1.35,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 8.5,
                  "fontWeight": "normal"
                }
